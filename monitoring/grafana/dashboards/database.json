{
  "id": null,
  "uid": "cinema-db",
  "title": "Cinema Database Performance",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "DB Container CPU (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Zuzycie CPU kontenera bazy (cAdvisor). 100% = jeden rdzen.",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"cinema_db\"}[1m])) * 100",
          "legendFormat": "cinema_db CPU"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Connections by State",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Polaczenia wg stanu (active / idle / idle in transaction).",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_stat_activity_states_connections) by (state)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Commits / Rollbacks (per s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tempo zatwierdzonych i wycofanych transakcji na bazie kino.",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"kino\"}[1m])",
          "legendFormat": "commits"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"kino\"}[1m])",
          "legendFormat": "rollbacks"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "x": 12, "y": 7, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Udzial odczytow z cache (blks_hit) vs z dysku. Ponizej ~0.99 sugeruje za maly shared_buffers / brak indeksow.",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_stat_database_blks_hit{datname=\"kino\"}) / (sum(pg_stat_database_blks_hit{datname=\"kino\"}) + sum(pg_stat_database_blks_read{datname=\"kino\"}))",
          "legendFormat": "hit ratio",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Waiting Locks (kontencja)",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 7, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Liczba blokad oczekujacych na przyznanie - wzrost = lock contention (hot rows).",
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(pg_locks_waiting_waiting)",
          "legendFormat": "waiting locks"
        }
      ]
    },
    {
      "id": 200,
      "title": "Top Queries (pg_stat_statements)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 6,
      "title": "Top 10 zapytan wg sredniego czasu (w oknie, ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Sredni czas wykonania liczony w wybranym przedziale czasu (delta total_exec / delta calls). Zapytania, ktore nie wykonuja sie w oknie, znikaja. Legenda = poczatek SQL.",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, rate(pg_stat_statements_total_exec_ms[$__rate_interval]) / clamp_min(rate(pg_stat_statements_calls[$__rate_interval]), 1))",
          "legendFormat": "{{short_query}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top zapytania wg lacznego czasu CPU bazy (ms/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Tempo przyrostu total_exec_time - pokazuje ktore zapytania najbardziej obciazaja CPU bazy.",
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, rate(pg_stat_statements_total_exec_ms[$__rate_interval]))",
          "legendFormat": "{{short_query}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Tabela: najciezsze zapytania w wybranym oknie",
      "type": "table",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Sredni czas wykonania w calym wybranym przedziale czasu (rate po $__range). Jednorazowe operacje spoza okna nie pojawiaja sie.",
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [{ "id": "displayName", "value": "sr. ms / zapytanie (okno)" }, { "id": "unit", "value": "ms" }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(20, rate(pg_stat_statements_total_exec_ms[$__range]) / clamp_min(rate(pg_stat_statements_calls[$__range]), 1))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "server": true, "usename": true },
            "indexByName": {}
          }
        }
      ]
    }
  ]
}
